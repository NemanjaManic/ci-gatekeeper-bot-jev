{
  "name": "ci-gatekeeper-bot-jev",
  "version": "0.1.0",
  "description": "GitHub Action that uses Jev (TypeSafe AI via Vercel AI Gateway) to cheaply triage pull requests before expensive LLM or human review",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "test": "vitest run tests/unit",
    "test:fixtures": "vitest run tests/fixtures",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^8.0.1",
    "ai": "^7.0.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "undici": "^7.29.1"
  }
}
